{
  "name": "turnike-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "stress": "node --env-file=.env.local --import tsx scripts/stress.ts",
    "test": "vitest run",
    "check:eip712": "node --env-file=.env.local --import tsx scripts/check-eip712.ts",
    "admin": "node --env-file=.env.local --env-file=../.deployer.env --import tsx scripts/admin.ts",
    "sweep": "node --env-file=.env.local --env-file=../.deployer.env --import tsx scripts/sweep.ts"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
